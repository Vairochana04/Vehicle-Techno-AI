# Copy to .env / set in your host's environment (never commit real secrets)
PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret
NODE_ENV=production
DB_PATH=/data/valuation.db
CORS_ORIGIN=https://your-domain.example
# X-Frame-Options: ALLOWALL (default, lets preview/host iframes embed the portal)
# or SAMEORIGIN / DENY for a locked-down production deployment.
FRAME_OPTIONS=ALLOWALL
# Live provider keys (future swap-ins, see docs/TECH_STACK_DECISION.md)
# VAHAN_API_KEY=
# IIB_API_KEY=
# DEEPSEARCH_API_KEY=
# KILLFAKE_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
